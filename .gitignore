/bin/
# `go build ./cmd/homed` from the module root writes the binary here; `make build` puts it in bin/.
/homed
/dist/
node_modules/
/internal/web/dist/*
!/internal/web/dist/.gitkeep
*.db
/data/
.env*
# Secrets: *.token files. (Not *token*: that would hide source files named like tokens.css.)
*.token
coverage.out
.DS_Store

# Generated by the admin UI screenshot run (npm --prefix web run screenshots); curated copies live in docs/images.
/docs/screenshots/
