{
  "name": "homie-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Homie admin SPA, embedded in homed (internal/web).",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock --outDir .mock-dist",
    "preview:mock": "vite preview --mode mock --outDir .mock-dist",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=smoke",
    "e2e:real": "playwright test --config tests/real/playwright.config.ts",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.6",
    "@devxpro/mcp-gatekeeper-ui": "github:devXpro/mcp-gatekeeper#v0.2.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "27.1.2",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
