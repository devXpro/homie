# Homie hub (homed) built from the sources, for development and for hosts that cannot pull the release image.
# The release image is Dockerfile (a finished binary copied in); same runtime, same usage:
#
#   docker build -f Dockerfile.dev -t homie:dev .
#   docker run -d --name homie --restart unless-stopped --network host -v homie:/data homie:dev
#
# Why --network host and why Docker Desktop on a Mac cannot do it: see the comments in Dockerfile.
# Build another CPU with --platform (for example linux/arm64); VERSION and COMMIT end up in `homed version`.

# The admin SPA is embedded in homed (internal/web/dist), so it is built first. Node 22+ (web/package.json).
FROM --platform=$BUILDPLATFORM node:22-alpine AS web
WORKDIR /src
COPY web/package.json web/package-lock.json web/
RUN npm --prefix web ci
COPY web web
# vite.config.ts reads internal/web/csp.txt and writes the build to internal/web/dist
COPY internal/web/csp.txt internal/web/csp.txt
RUN npm --prefix web run build

# go.mod pins toolchain go1.26.11, the same as this image, so Go does not download a toolchain.
FROM --platform=$BUILDPLATFORM golang:1.26.11-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
ARG VERSION=dev
ARG COMMIT=none
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd cmd
COPY internal internal
COPY pluginkit pluginkit
COPY --from=web /src/internal/web/dist internal/web/dist
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH GOARM=${TARGETVARIANT#v} \
	go build -trimpath -ldflags "-s -w -X main.version=$VERSION -X main.commit=$COMMIT" -o /out/homed ./cmd/homed

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata tini \
	&& addgroup -S -g 10001 homie \
	&& adduser -S -u 10001 -G homie -h /data -H -s /sbin/nologin homie \
	&& install -d -m 0700 -o homie -g homie /data
COPY --from=build --chmod=0755 /out/homed /usr/local/bin/homed
COPY LICENSE /usr/share/licenses/homie/LICENSE
ENV HOMED_DATA_DIR=/data
VOLUME /data
WORKDIR /data
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
	CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/homed"]
CMD ["run"]
