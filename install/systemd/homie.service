# Homie hub (homed), installed by install/home.sh as /etc/systemd/system/homie.service.
# The installer fills in the program paths; do not edit the installed copy, it is rewritten on
# every update (use `systemctl edit homie` for local changes).
[Unit]
Description=Homie hub (homed)
Documentation=https://github.com/devXpro/homie
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=homie
Group=homie
Environment=HOMED_DATA_DIR=/var/lib/homie
WorkingDirectory=/var/lib/homie
ExecStart=__HOMED_BIN__ run
# A hub update from the admin replaces the binary and exits with status 75 on purpose; Restart=always starts the new
# one. Keep 75 out of SuccessExitStatus= and RestartPreventExitStatus=.
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

# Hardening. The hub needs the LAN as it is (SSDP multicast, UDP broadcast for Wake-on-LAN, ARP table), so there is no
# network isolation at all (no private network namespace, no IP address filter). Plugins are child processes and
# inherit all of this.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/homie __LIB_DIR__
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
